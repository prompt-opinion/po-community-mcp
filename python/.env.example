# Trajectory.OS — Twilio configuration for DispatchPostpartumAlert
# Copy this file to `.env` and fill in real values. `python-dotenv` loads it
# automatically at server startup (see main.py).

# ── Required ────────────────────────────────────────────────────────────────
# Find these at https://console.twilio.com/  (Account Info panel)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio-owned sender number in E.164 format. Trial accounts get one
# free number — copy it from the Twilio console "Phone Numbers" page.
TWILIO_FROM_NUMBER=+15551234567

# ── Optional (recommended for the demo) ────────────────────────────────────
# Twilio TRIAL accounts only deliver to verified recipient numbers. Set this
# to YOUR phone (the one you've verified in the Twilio console) so every
# dispatch lands on the demo phone instead of the synthetic patient's
# unreachable FHIR telecom value.
#
# Leave commented out / blank in production — the tool will then use
# Patient.telecom from the FHIR record.
TWILIO_DEMO_RECIPIENT_OVERRIDE=+15559876543
